# SQLite by default. Swap for a PostgreSQL connection string in production.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Email (optional). Without SMTP_HOST, submissions are saved but no emails are sent
# and newsletter signups are confirmed immediately. Hostinger mailbox example:
# SMTP_HOST="smtp.hostinger.com"  SMTP_PORT=465
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Mawuwebs <hello@yourdomain.com>"
# Where new enquiries / estimates are sent. Defaults to the contact email in Admin > Settings.
NOTIFY_EMAIL=""

# Analytics (optional, Plausible). Leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# Weekly lead digest. Set a long random value, then have a scheduler call
#   GET /api/cron/digest  with header  Authorization: Bearer <CRON_SECRET>
# The endpoint is disabled while this is empty.
CRON_SECRET=""

# Online invoice payments: enter the Paystack / Stripe keys in Admin > Payments (stored encrypted).
# These variables are only a fallback if you prefer to keep keys on the server instead.
# PAYSTACK_SECRET_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Rate limiting: how many reverse proxies sit in front of the app (read from the right of
# X-Forwarded-For). 0 = ignore the header (app exposed directly). Set TRUSTED_PROXY_CLOUDFLARE=1
# only if every request really arrives through Cloudflare.
TRUSTED_PROXY_HOPS=1
TRUSTED_PROXY_CLOUDFLARE=0

# Uploaded files directory (default ./public/uploads). Point at a persistent, backed-up folder in production.
UPLOAD_DIR=""

# Origin the proxy uses to read the redirect map (default AUTH_URL). Use http://127.0.0.1:PORT behind a reverse proxy.
INTERNAL_ORIGIN=""
