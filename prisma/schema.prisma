// Mawuwebs Solutions — database schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  EDITOR
  CONTENT
  SUPPORT
  CLIENT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum CategoryType {
  POST
  PROJECT
}

enum SubmissionStatus {
  NEW
  READ
  RESPONDED
  QUOTED
  WON
  LOST
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(EDITOR)
  image         String?
  totpSecret        String?
  totpEnabled       Boolean   @default(false)
  totpLastStep      Int?
  recoveryCodes     String    @default("[]")
  passwordChangedAt DateTime?
  mustChangePassword Boolean  @default(false)
  lastLoginAt       DateTime?
  disabledAt        DateTime?
  company           String    @default("")
  // Client profile (used for CLIENT users; empty for staff)
  phone             String    @default("")
  /// Separate WhatsApp number when it differs from the phone.
  whatsapp          String    @default("")
  jobTitle          String    @default("")
  address           String    @default("")
  city              String    @default("")
  country           String    @default("")
  website           String    @default("")
  /// TIN / VAT number, printed on invoices.
  taxId             String    @default("")
  /// Where invoices are emailed when it is not the sign-in email.
  billingEmail      String    @default("")
  industry          String    @default("")
  /// How they found us: referral, website, social, event...
  source            String    @default("")
  /// Internal only. Never shown to the client.
  notes             String    @default("")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  posts         Post[]
  activityLogs  ActivityLog[]
  resetTokens   PasswordResetToken[]
  tickets       Ticket[]
  assets        ClientAsset[]
  documents     ClientDocument[]
  projects      ClientProject[]
  quotes        Quote[]
  invoices      Invoice[]
  recurring     RecurringInvoice[]
  enquiries     ContactSubmission[]
}

model Page {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  content         String        @default("")
  status          ContentStatus @default(DRAFT)
  featuredImage   String?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  noIndex         Boolean       @default(false)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Service {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  description     String        @default("")
  content         String        @default("")
  icon            String        @default("Sparkles")
  category        String        @default("Software & Web")
  featuredImage   String?
  status          ContentStatus @default(DRAFT)
  featured        Boolean       @default(false)
  order           Int           @default(0)
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  noIndex         Boolean       @default(false)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Project {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  description     String        @default("")
  content         String        @default("")
  featuredImage   String?
  gallery         String        @default("[]")
  client          String?
  projectUrl      String?
  challenge       String        @default("")
  solution        String        @default("")
  results         String        @default("[]")
  year            String?
  role            String?
  status          ContentStatus @default(DRAFT)
  featured        Boolean       @default(false)
  order           Int           @default(0)
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  noIndex         Boolean       @default(false)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id])
  tags            Tag[]         @relation("ProjectTags")
}

model Post {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  excerpt         String        @default("")
  content         String        @default("")
  featuredImage   String?
  status          ContentStatus @default(DRAFT)
  featured        Boolean       @default(false)
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  noIndex         Boolean       @default(false)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  authorId        String?
  author          User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id])
  tags            Tag[]         @relation("PostTags")
}

model Category {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  type      CategoryType
  createdAt DateTime     @default(now())

  posts     Post[]
  projects  Project[]
}

model Tag {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())

  posts     Post[]    @relation("PostTags")
  projects  Project[] @relation("ProjectTags")
}

model Testimonial {
  id        String        @id @default(cuid())
  name      String
  role      String        @default("")
  company   String        @default("")
  avatar    String?
  content   String
  rating    Int           @default(5)
  status    ContentStatus @default(DRAFT)
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Faq {
  id        String        @id @default(cuid())
  question  String
  answer    String
  category  String        @default("General")
  status    ContentStatus @default(DRAFT)
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model SiteSettings {
  id                    String   @id @default("main")
  siteName              String   @default("Mawuwebs Solutions")
  tagline               String   @default("Modern Web & Digital Solutions")
  logo                  String?
  favicon               String?
  contactEmail          String   @default("hello@mawuwebs.com")
  phone                 String   @default("+1 (555) 123-4567")
  address               String   @default("123 Innovation Drive, Suite 400, Tech City")
  mapEmbedUrl           String?
  footerText            String   @default("Building modern digital experiences that grow your business.")
  heroHeadline          String   @default("Modern Web Solutions That Grow Your Business")
  heroSubheading        String   @default("We design, build, and scale premium digital products for ambitious companies.")
  heroCtaPrimaryText    String   @default("Start a Project")
  heroCtaPrimaryUrl     String   @default("/contact")
  heroCtaSecondaryText  String   @default("View Our Work")
  heroCtaSecondaryUrl   String   @default("/portfolio")
  heroImage             String?
  metrics               String   @default("[]")
  newsletterEnabled     Boolean  @default(true)
  bookingUrl            String?
  whatsapp              String?
  serviceArea           String?
  supportPromise        String?
  trustLogos            String   @default("[]")
  googleVerification    String?
  bingVerification      String?
  updatedAt             DateTime @updatedAt
}

model ContactSubmission {
  id        String           @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String           @default("")
  message   String
  notes     String           @default("")
  kind        String           @default("message")
  urgent      Boolean          @default(false)
  serviceSlug String           @default("")
  status      SubmissionStatus @default(NEW)
  quoteAmount Int?
  lostReason  String           @default("")
  followUpAt  DateTime?
  repliedAt   DateTime?
  statusChangedAt DateTime?
  createdAt   DateTime         @default(now())

  /// Set when the enquiry has been turned into (or matched to) a client.
  clientId    String?
  client      User?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  quotes      Quote[]

  @@index([status, createdAt])
  @@index([kind])
  @@index([serviceSlug])
}

model NewsletterSubscriber {
  id          String    @id @default(cuid())
  email       String    @unique
  token       String?   @unique
  confirmedAt DateTime?
  source      String    @default("")
  unsubscribedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  alt       String   @default("")
  createdAt DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  message    String
  createdAt  DateTime @default(now())

  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Revision {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  snapshot   String
  label      String   @default("")
  authorName String   @default("")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

model Plan {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  tagline     String        @default("")
  forWho      String        @default("")
  features    String        @default("[]")
  price       String?
  highlight   Boolean       @default(false)
  order       Int           @default(0)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  scheduledAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

/// Admin-editable lists for public forms (support options, estimate wizard). Value is validated JSON.
model FormConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Taps on phone / WhatsApp / email links, so direct contact shows up next to form enquiries.
model ContactClick {
  id        String   @id @default(cuid())
  channel   String
  page      String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  permanent Boolean  @default(true)
  hits      Int      @default(0)
  auto      Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
}

/// Client portal: a support request raised by a CLIENT user.
model Ticket {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  urgent    Boolean      @default(false)
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  resolvedAt DateTime?
  replies   TicketReply[]

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model TicketReply {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  /// Null when the client wrote it.
  staffName String?
  body      String
  /// Staff-only note, never shown in the portal.
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// Things we look after for a client: devices, licences, domains.
model ClientAsset {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  type       String    @default("Device")
  details    String    @default("")
  assignedTo String    @default("")
  expiresAt  DateTime?
  /// Highest renewal notice already sent for the current expiry (0 none, 1 = 30 days, 2 = 7 days, 3 = expired).
  renewalStage Int     @default(0)
  /// Optional public URL pinged by the uptime cron. Empty = not monitored.
  monitorUrl String    @default("")
  /// Set while the last checks failed; cleared on recovery. Used to alert once per outage.
  monitorDownSince DateTime?
  monitorCheckedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([monitorUrl])
}

/// Reports, invoices and contracts shared with a client. Reports carry their text in `body`; others link to a file.
model ClientDocument {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  kind      String   @default("report")
  body      String   @default("")
  url       String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Client work and billing. All money is an integer in minor units (pesewas,
// cents) with a currency code, never a float. Tax rates are basis points
// (1250 = 12.5%).
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  ON_HOLD
  DONE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

/// Work we do for a client. Not the public portfolio (that is `Project`).
model ClientProject {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  summary     String        @default("")
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  dueDate     DateTime?
  /// JSON array of { title, done, dueDate? }.
  milestones  String        @default("[]")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  quotes      Quote[]
  invoices    Invoice[]

  @@index([userId, createdAt])
}

model Quote {
  id            String       @id @default(cuid())
  number        String       @unique
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId     String?
  project       ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  submissionId  String?
  submission    ContactSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  title         String
  currency      String       @default("GHS")
  taxBp         Int          @default(0)
  notes         String       @default("")
  status        QuoteStatus  @default(DRAFT)
  validUntil    DateTime?
  /// Percent (0-99) to invoice up front once accepted. 0 = no deposit.
  depositPct    Int          @default(0)
  /// Unguessable id for the emailed link.
  token         String       @unique
  sentAt        DateTime?
  /// When the unanswered-quote follow-up email went out (sent at most once).
  nudgedAt      DateTime?
  acceptedAt    DateTime?
  acceptedBy    String?
  declinedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items         QuoteItem[]
  invoices      Invoice[]

  @@index([userId, createdAt])
  @@index([status])
}

model QuoteItem {
  id          String @id @default(cuid())
  quoteId     String
  quote       Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Int    @default(1)
  unitAmount  Int
  position    Int    @default(0)

  @@index([quoteId, position])
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quoteId     String?
  quote       Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  title       String
  currency    String        @default("GHS")
  taxBp       Int           @default(0)
  notes       String        @default("")
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime      @default(now())
  dueDate     DateTime?
  token       String        @unique
  sentAt      DateTime?
  paidAt      DateTime?
  /// full | deposit | balance (the last two come from a quote with a deposit)
  kind        String        @default("full")
  reminderCount  Int        @default(0)
  lastReminderAt DateTime?
  /// Set when the "due soon" email goes out, so it is sent once.
  preDueReminderAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items       InvoiceItem[]
  payments    Payment[]

  @@index([userId, createdAt])
  @@index([status, dueDate])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitAmount  Int
  position    Int     @default(0)

  @@index([invoiceId, position])
}

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Int
  /// momo | bank | cash | card | paystack | stripe | other
  method    String   @default("bank")
  reference String   @default("")
  note      String   @default("")
  paidAt    DateTime @default(now())
  /// Gateway transaction id. Unique so a replayed webhook cannot record the same payment twice.
  externalId String? @unique
  createdAt DateTime @default(now())

  @@index([invoiceId, paidAt])
}

/// Atomic counters for document numbers (key like "invoice-2026").
model Sequence {
  key   String @id
  value Int    @default(0)
}

/// A schedule that drafts (and optionally emails) an invoice every N months, e.g. a managed IT plan.
model RecurringInvoice {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String
  unitAmount     Int
  currency       String    @default("GHS")
  taxBp          Int       @default(0)
  notes          String    @default("")
  intervalMonths Int       @default(1)
  dueDays        Int       @default(14)
  nextRunAt      DateTime
  lastRunAt      DateTime?
  autoSend       Boolean   @default(false)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@index([active, nextRunAt])
}

/// Payment gateway credentials entered in the admin UI. `value` is AES-256-GCM ciphertext (see src/lib/secrets.ts), never plain text.
model PaymentSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Business details and defaults for quotes and invoices (single row, id "main").
model BillingSettings {
  id                  String   @id @default("main")
  legalName           String   @default("")
  taxId               String   @default("")
  paymentInstructions String   @default("")
  quoteTerms          String   @default("")
  defaultCurrency     String   @default("GHS")
  defaultTaxBp        Int      @default(0)
  defaultDueDays      Int      @default(14)
  remindersEnabled    Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

/// Every payment webhook we receive and what we did with it, so money and books can be reconciled.
model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  eventType String
  /// recorded | duplicate | ignored | rejected | error | skipped
  outcome   String
  detail    String   @default("")
  reference String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([outcome, createdAt])
}
